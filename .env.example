DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=indrive_car_check.settings
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DATABASE_PATH=db.sqlite3
DJANGO_TIME_ZONE=UTC
MAX_IMAGE_BYTES=5242880
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
CAR_DATA_ROOT=fresh_data
CAR_MODEL_PATH=ml_model/car_condition.joblib
VISION_MODEL_ID=openai/clip-vit-base-patch32
VISION_MODEL_CACHE_DIR=.model_cache
VISION_DEVICE=auto
VISION_BATCH_SIZE=16
INTEGRITY_MIN_CLEAN_PROBABILITY=0.35
DAMAGE_OVERRIDE_PROBABILITY=0.50
LOCALIZATION_GRID_COLUMNS=4
LOCALIZATION_GRID_ROWS=3
LOCALIZATION_WINDOW_RATIO=0.42
DIRT_REGION_THRESHOLD=0.55
DAMAGE_REGION_THRESHOLD=0.38
LOCALIZATION_NMS_THRESHOLD=0.35
LOCALIZATION_MAX_REGIONS=6
APP_HOST=
APP_PORT=
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
